<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: lets the app reach the optional MuJoCo visor on the development machine. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+ blocks private addresses such as 10.0.2.2 without it. Grant it with
         adb shell pm grant com.example.robottirabasura android.permission.ACCESS_LOCAL_NETWORK -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
